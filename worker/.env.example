# Copy to .env before running:  cp .env.example .env
# Hosts point at localhost because the service runs on the host while
# PostgreSQL and RabbitMQ run in Docker.

POSTGRES_USER=ontology
POSTGRES_PASSWORD=ontology
POSTGRES_DB=ontology_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Relative to the service directory this runs from, so api/ and worker/ both
# resolve to the same <repo>/uploads.
UPLOAD_DIR=../uploads
MAX_RETRY_ATTEMPTS=3
PREFETCH_COUNT=1
RECONNECT_INTERVAL=5
